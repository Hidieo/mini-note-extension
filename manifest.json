{
  "manifest_version": 3,
  "name": "Minimalist Notes",
  "version": "1.0",
  "description": "Tulis catatan cepat yang berbeda di setiap website.",
  "permissions": ["storage", "activeTab", "scripting"],
  "commands": {
    "toggle_notes_input": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Tampilkan atau sembunyikan input catatan"
    }
  },"background": {
  "service_worker": "background.js"
  },"action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}